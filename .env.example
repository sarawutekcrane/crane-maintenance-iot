APP_ENV=development

FRONTEND_PORT=5173
BACKEND_PORT=8000

DATA_REPOSITORY=mock

PUBLIC_BASE_URL=http://127.0.0.1:5173

GOOGLE_SHEET_ID=
GOOGLE_APPLICATION_CREDENTIALS=

FILE_STORAGE_BACKEND=local
LOCAL_UPLOAD_DIR=./data/uploads

DEV_AUTH_MODE=true
LOG_LEVEL=INFO

# Attachment upload validation (Phase 3 correction). LOCAL DEVELOPMENT
# DEFAULTS ONLY -- OPEN_DECISIONS_REGISTER_EN.txt M07 (production file
# upload limits/MIME/malware-scanning policy) remains unresolved. Do not
# treat these as an approved production policy.
ATTACHMENT_MAX_SIZE_BYTES=10485760
ATTACHMENT_ALLOWED_CONTENT_TYPES=image/jpeg,image/png,image/webp,image/gif